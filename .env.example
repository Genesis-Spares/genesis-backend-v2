# Copy to .env. Every service reads this file from the repo root.
# docker-compose overrides the database URLs and service hosts for its own network,
# so under Docker you mainly need the secrets below.

# ── Databases (one per service) ─────────────────────────────
POSTGRES_PASSWORD=genesis
AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/genesis_auth
CUSTOMER_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/genesis_customer
NOTIFICATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/genesis_notification
CATALOG_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/genesis_catalog
ORDER_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/genesis_order

# ── Redis (events between services, product cache) ──────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Auth ────────────────────────────────────────────────────
# Long random string, e.g. `openssl rand -hex 32`. Must be the same for every service.
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
# Default accounts created by `pnpm db:seed` (only when they don't exist yet).
# Leave blank locally to get admin@genesis.com / Admin123!@#; ALWAYS set in production.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_STAFF_EMAIL=
SEED_STAFF_PASSWORD=

# ── Service ports / hosts (local, non-Docker) ───────────────
API_GATEWAY_PORT=11000
AUTH_SERVICE_HOST=127.0.0.1
AUTH_SERVICE_PORT=11001
NOTIFICATION_PORT=11003
PRODUCT_HOST=localhost
PRODUCT_PORT=11004
PRODUCT_SERVICE_HOST=localhost
PRODUCT_SERVICE_PORT=11004
CUSTOMER_SERVICE_HOST=localhost
CUSTOMER_SERVICE_PORT=11005
ORDER_SERVICE_HOST=localhost
ORDER_SERVICE_PORT=11006

# ── Storefront build (docker compose --profile frontends) ───
# Google Maps browser key for address suggestions and the delivery pin map
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=

# ── Public URLs ─────────────────────────────────────────────
# Browsers allowed to call the API (comma-separated). Blank = local defaults.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Used in email/SMS links.
STOREFRONT_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3001

# ── Email (SMTP) ────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
# Replies to emails sent from the dashboard (and support replies) go here
SUPPORT_INBOX_EMAIL=
STOCK_ALERT_EMAIL=
# URL prefixes email attachments may be fetched from (dashboard uploads go to Cloudinary)
EMAIL_ATTACHMENT_HOSTS=https://res.cloudinary.com/

# ── SMS (Africa's Talking; optional) ────────────────────────
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
STOCK_ALERT_PHONE=

# ── Orders ──────────────────────────────────────────────────
RETURN_WINDOW_DAYS=7

# ── M-Pesa (Safaricom Daraja, Lipa na M-Pesa Online / STK push) ──
# sandbox | production | mock. Blank = mock locally when no credentials are set;
# in production (NODE_ENV=production) M-Pesa checkout fails until configured.
MPESA_ENV=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Paybill (or head-office store number for a till). Sandbox: 174379 with the sandbox passkey.
MPESA_SHORTCODE=
MPESA_PASSKEY=
# CustomerPayBillOnline (paybill) or CustomerBuyGoodsOnline (till; set MPESA_PARTY_B to the till number)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_PARTY_B=
# Public HTTPS address of the gateway's callback route (Safaricom must reach it; use a tunnel such as
# ngrok locally). The secret is appended as the last path segment, so the full URL Daraja calls is
# ${MPESA_CALLBACK_URL}/${MPESA_CALLBACK_SECRET}.
MPESA_CALLBACK_URL=https://api.example.com/api/payments/mpesa/callback
MPESA_CALLBACK_SECRET=change-me-to-a-long-random-string
# Minutes a shopper has to pay before the order is cancelled and its stock released.
MPESA_PAYMENT_TIMEOUT_MINUTES=30
# Mock mode only: delay before the simulated payment result. Phones ending in 0000 decline.
MPESA_MOCK_DELAY_MS=4000
