// apps/customer-service/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id     String @id @default(uuid())
  userId String @unique @map("user_id") // Reference to auth User (no FK)

  // Denormalized from Auth Service (synced via events)
  email     String  @unique
  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  phone     String?

  // Customer-specific data
  avatar      String?
  dateOfBirth DateTime? @map("date_of_birth")
  gender      String? // MALE, FEMALE, OTHER, PREFER_NOT_TO_SAY
  language    String    @default("en")
  timezone    String    @default("UTC")
  currency    String    @default("USD")

  // Preferences
  preferences CustomerPreference?

  // Loyalty
  loyaltyPoints Int    @default(0) @map("loyalty_points")
  loyaltyTier   String @default("BRONZE") @map("loyalty_tier") // BRONZE, SILVER, GOLD, PLATINUM

  // Status
  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at")
  loginCount  Int       @default(0) @map("login_count")

  // Relationships (within this service only)
  addresses      Address[]
  communications Communication[]
  emails         EmailRecipient[]
  notes          CustomerNote[]
  activities     CustomerActivity[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([email])
  @@index([loyaltyTier])
  @@map("customers")
}

model CustomerPreference {
  id         String @id @default(uuid())
  customerId String @unique @map("customer_id")

  // Communication preferences
  emailNotifications Boolean @default(true) @map("email_notifications")
  smsNotifications   Boolean @default(false) @map("sms_notifications")
  pushNotifications  Boolean @default(true) @map("push_notifications")
  marketingEmails    Boolean @default(true) @map("marketing_emails")

  // Privacy
  dataSharingConsent Boolean @default(true) @map("data_sharing_consent")
  cookieConsent      Boolean @default(true) @map("cookie_consent")

  // Preferences
  preferredCategories String[] @map("preferred_categories")
  preferredBrands     String[] @map("preferred_brands")
  productViewHistory  Json?    @map("product_view_history")
  searchHistory       Json?    @map("search_history")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("customer_preferences")
}

model Address {
  id         String @id @default(uuid())
  customerId String @map("customer_id")

  label String // Home, Work, etc.
  type  String @default("SHIPPING") // SHIPPING, BILLING, BOTH

  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String  @map("postal_code")
  country    String
  phone      String? // Phone specific to this address

  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  latitude  Float?
  longitude Float?

  deliveryInstructions String? @map("delivery_instructions")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([customerId, label])
  @@index([customerId])
  @@index([isDefault])
  @@map("addresses")
}

model Communication {
  id         String @id @default(uuid())
  customerId String @map("customer_id")

  type      String // EMAIL, SMS, PUSH, IN_APP, WHATSAPP
  direction String // INBOUND, OUTBOUND
  subject   String?
  content   String
  status    String // SENT, DELIVERED, READ, FAILED, BOUNCED
  metadata  Json?

  sentAt      DateTime? @map("sent_at")
  deliveredAt DateTime? @map("delivered_at")
  readAt      DateTime? @map("read_at")
  failedAt    DateTime? @map("failed_at")
  error       String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("communications")
}

model CustomerNote {
  id         String @id @default(uuid())
  customerId String @map("customer_id")

  content  String
  type     String // GENERAL, SUPPORT, SALES, COMPLAINT, FEEDBACK
  authorId String @map("author_id") // User ID from auth-service

  isInternal Boolean @default(true) @map("is_internal")
  isPinned   Boolean @default(false) @map("is_pinned")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([type])
  @@map("customer_notes")
}

model CustomerActivity {
  id         String @id @default(uuid())
  customerId String @map("customer_id")

  action     String // LOGIN, LOGOUT, VIEW_PRODUCT, ADD_TO_CART, PLACE_ORDER, etc.
  resource   String? // Resource type (PRODUCT, ORDER, etc.)
  resourceId String? @map("resource_id") // ID of the resource

  metadata  Json?
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([customerId])
  @@index([action])
  @@index([createdAt])
  @@map("customer_activities")
}

model CustomerSegment {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  criteria    Json

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("customer_segments")
}

model CustomerSegmentAssignment {
  id         String @id @default(uuid())
  customerId String @map("customer_id")
  segmentId  String @map("segment_id")

  assignedAt DateTime @default(now()) @map("assigned_at")

  @@unique([customerId, segmentId])
  @@index([customerId])
  @@index([segmentId])
  @@map("customer_segment_assignments")
}

// A customer/support inbox — "check on messages" on the admin dashboard.
// Deliberately not tied to a required Customer relation: a message can come
// from a guest via a public contact form (no account yet), so contact
// details are captured directly on the message, the same way Order snapshots
// customerName/customerEmail/customerPhone rather than requiring the FK.
model SupportMessage {
  id String @id @default(uuid())

  customerId    String? @map("customer_id") // set when the sender is a known/logged-in customer
  customerName  String  @map("customer_name")
  customerEmail String  @map("customer_email")
  customerPhone String? @map("customer_phone")

  subject String
  body    String

  status   String @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority String @default("NORMAL") // LOW, NORMAL, HIGH, URGENT

  // Optional link to the order this message is about
  orderId     String? @map("order_id")
  orderNumber String? @map("order_number")

  assignedTo     String? @map("assigned_to") // staff userId currently handling this
  assignedToName String? @map("assigned_to_name") // display label (staff email) for assignedTo

  replies SupportMessageReply[]

  resolvedAt DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([priority])
  @@index([customerId])
  @@index([assignedTo])
  @@index([createdAt])
  @@map("support_messages")
}

model SupportMessageReply {
  id        String @id @default(uuid())
  messageId String @map("message_id")

  body       String
  authorId   String  @map("author_id") // staff userId who wrote the reply
  authorName String? @map("author_name") // display label (staff email), set server-side from the JWT
  isInternal Boolean @default(false) @map("is_internal") // internal note vs. a reply sent to the customer

  message SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([messageId])
  @@map("support_message_replies")
}

/// An email composed by staff in the dashboard (draft or sent). Each recipient
/// gets their own copy, personalised with merge fields such as {{firstName}}.
model EmailMessage {
  id          String   @id @default(uuid())
  subject     String   @default("")
  html        String   @default("") // sanitised rich-text body
  cc          String[]
  bcc         String[]
  attachments Json? // [{ name, url, size, type }] — Cloudinary URLs
  branded     Boolean  @default(true) // wrap in the Genesis email design
  marketing   Boolean  @default(false) // skip customers who opted out of marketing emails

  status String @default("DRAFT") // DRAFT, SENDING, SENT, PARTIAL, FAILED

  createdById    String?   @map("created_by_id")
  createdByEmail String?   @map("created_by_email")
  sentAt         DateTime? @map("sent_at")

  recipients EmailRecipient[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([updatedAt])
  @@map("email_messages")
}

model EmailRecipient {
  id             String  @id @default(uuid())
  emailMessageId String  @map("email_message_id")
  customerId     String? @map("customer_id") // null for an address typed by hand
  email          String
  name           String?

  status String    @default("PENDING") // PENDING, SENT, FAILED, SKIPPED
  error  String?
  sentAt DateTime? @map("sent_at")

  message  EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)
  customer Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([emailMessageId])
  @@index([customerId])
  @@map("email_recipients")
}
