// apps/order-service/prisma/schema.prisma
generator client {
    provider = "prisma-client-js"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model Order {
    id          String @id @default(uuid())
    orderNumber String @unique @map("order_number")

    // Denormalized from Customer Service (no FK — separate DB)
    customerId    String  @map("customer_id")
    customerEmail String  @map("customer_email")
    customerName  String  @map("customer_name")
    customerPhone String? @map("customer_phone")

    status        String @default("PENDING") // PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED, REFUNDED
    paymentStatus String @default("PENDING") @map("payment_status") // PENDING, PAID, FAILED, REFUNDED, PARTIALLY_REFUNDED
    paymentMethod String? @map("payment_method")

    currency String @default("KES")

    // Money — snapshotted at order time
    subtotal       Decimal @db.Decimal(10, 2)
    taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(10, 2)
    shippingAmount Decimal @default(0) @map("shipping_amount") @db.Decimal(10, 2)
    discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(10, 2)
    total          Decimal @db.Decimal(10, 2)

    // VAT % applied to this order, snapshotted so later rate changes don't rewrite history
    taxRate          Decimal?  @map("tax_rate") @db.Decimal(5, 2)
    deliveryZoneName String?   @map("delivery_zone_name")
    // unpaid M-Pesa orders are cancelled (and their stock released) after this
    paymentDueAt     DateTime? @map("payment_due_at")

    couponCode   String? @map("coupon_code")
    customerNote String? @map("customer_note")

    // Address snapshots (immutable copy — not a live reference to the customer's saved address)
    shippingAddress Json  @map("shipping_address")
    billingAddress  Json? @map("billing_address")

    trackingNumber  String? @map("tracking_number")
    trackingCarrier String? @map("tracking_carrier")
    estimatedDeliveryAt DateTime? @map("estimated_delivery_at")

    shippedAt    DateTime? @map("shipped_at")
    deliveredAt  DateTime? @map("delivered_at")
    cancelledAt  DateTime? @map("cancelled_at")
    cancelReason String?   @map("cancel_reason")

    items         OrderItem[]
    statusHistory OrderStatusHistory[]
    notes         OrderNote[]
    returns       ReturnRequest[]
    payments      Payment[]

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@index([customerId])
    @@index([status])
    @@index([paymentStatus])
    @@index([paymentDueAt])
    @@index([orderNumber])
    @@index([createdAt])
    @@map("orders")
}

model OrderItem {
    id      String @id @default(uuid())
    orderId String @map("order_id")

    // Denormalized from Product Service (no FK — separate DB)
    productId String  @map("product_id")
    variantId String? @map("variant_id")
    sku       String
    name      String
    image     String?

    unitPrice  Decimal @map("unit_price") @db.Decimal(10, 2)
    // cost of the part when it was sold (for profit reports); null on orders placed before this was recorded
    unitCost   Decimal? @map("unit_cost") @db.Decimal(10, 2)
    quantity   Int
    subtotal   Decimal @db.Decimal(10, 2)
    attributes Json?

    order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now()) @map("created_at")

    @@index([orderId])
    @@index([productId])
    @@map("order_items")
}

model OrderStatusHistory {
    id      String @id @default(uuid())
    orderId String @map("order_id")

    // STATUS = lifecycle change, TRACKING = shipment/location update,
    // PAYMENT = payment status change, UPDATE = other admin edit
    type      String  @default("STATUS")
    status    String // order status at the time of the entry
    note      String?
    location  String? // e.g. "Nairobi dispatch hub" — shown on the customer's tracker
    isPublic  Boolean @default(true) @map("is_public") // false = internal, hidden from the customer
    changedBy String? @map("changed_by") // userId of the admin who made the change, if any
    actor     String? // display label for changedBy (admin email) or "system" / "customer"

    order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now()) @map("created_at")

    @@index([orderId])
    @@index([createdAt])
    @@map("order_status_history")
}

model OrderNote {
    id      String @id @default(uuid())
    orderId String @map("order_id")

    content    String
    authorId   String  @map("author_id")
    isInternal Boolean @default(true) @map("is_internal")

    order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@index([orderId])
    @@map("order_notes")
}

/// Customer return (RMA). Lifecycle: REQUESTED → APPROVED | REJECTED → RECEIVED → REFUNDED.
/// Exchanges are handled as a refund + a new order for now.
model ReturnRequest {
    id        String @id @default(uuid())
    rmaNumber String @unique @map("rma_number") // RMA-20260925-4821
    orderId   String @map("order_id")
    customerId String @map("customer_id")

    status     String  @default("REQUESTED") // REQUESTED, APPROVED, REJECTED, RECEIVED, REFUNDED
    reason     String // WRONG_PART, DOESNT_FIT, DAMAGED, FAULTY, NOT_AS_DESCRIBED, CHANGED_MIND
    details    String?
    photos     String[] // image URLs (Cloudinary)
    resolution String  @default("REFUND") // REFUND | EXCHANGE (customer's preference)

    // decisions
    instructions  String? // shown to the customer on approval (how to send it back)
    rejectReason  String? @map("reject_reason")
    restocked     Boolean @default(false)
    refundAmount  Decimal? @map("refund_amount") @db.Decimal(10, 2)
    adminNote     String? @map("admin_note") // internal only

    approvedAt DateTime? @map("approved_at")
    rejectedAt DateTime? @map("rejected_at")
    receivedAt DateTime? @map("received_at")
    refundedAt DateTime? @map("refunded_at")

    items ReturnItem[]
    order Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@index([orderId])
    @@index([customerId])
    @@index([status])
    @@map("return_requests")
}

model ReturnItem {
    id          String  @id @default(uuid())
    returnId    String  @map("return_id")
    orderItemId String  @map("order_item_id")
    productId   String  @map("product_id")
    sku         String
    name        String
    quantity    Int
    unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)

    returnRequest ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)

    @@index([returnId])
    @@index([orderItemId])
    @@map("return_items")
}

/// One M-Pesa STK push attempt. An order can have several (failed / cancelled
/// prompts followed by a retry); at most one ends up SUCCESS.
model Payment {
    id       String @id @default(uuid())
    orderId  String @map("order_id")
    provider String @default("MPESA")
    status   String @default("PENDING") // PENDING, SUCCESS, FAILED

    amount   Decimal @db.Decimal(10, 2) // whole shillings actually requested from the phone
    currency String  @default("KES")
    phone    String // 2547XXXXXXXX

    merchantRequestId String?   @map("merchant_request_id")
    checkoutRequestId String?   @unique @map("checkout_request_id")
    receiptNumber     String?   @unique @map("receipt_number")
    resultCode        Int?      @map("result_code")
    resultDesc        String?   @map("result_desc")
    paidAt            DateTime? @map("paid_at")
    raw               Json? // last callback / status-query payload, for support

    order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@index([orderId])
    @@index([status])
    @@map("payments")
}

/// Delivery pricing. A shopper's town picks the zone; towns no zone lists
/// fall back to the zone marked isDefault.
model DeliveryZone {
    id          String   @id @default(uuid())
    name        String
    description String?
    cities      String[] // lower-case town names
    isDefault   Boolean  @default(false) @map("is_default")

    fee        Decimal  @db.Decimal(10, 2)
    perKgFee   Decimal  @default(0) @map("per_kg_fee") @db.Decimal(10, 2) // charged per started kg above includedKg
    includedKg Decimal  @default(0) @map("included_kg") @db.Decimal(10, 2)
    freeAbove  Decimal? @map("free_above") @db.Decimal(10, 2) // goods subtotal that makes delivery free

    minDays   Int     @default(1) @map("min_days")
    maxDays   Int     @default(3) @map("max_days")
    allowsCod Boolean @default(false) @map("allows_cod")
    isActive  Boolean @default(true) @map("is_active")
    sortOrder Int     @default(0) @map("sort_order")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("delivery_zones")
}

/// Single-row store-wide checkout settings (id is always 1).
model CheckoutSettings {
    id            Int     @id @default(1)
    vatRate       Decimal @default(16) @map("vat_rate") @db.Decimal(5, 2) // %, added on top of prices
    vatOnShipping Boolean @default(true) @map("vat_on_shipping")

    updatedBy String?  @map("updated_by")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("checkout_settings")
}
